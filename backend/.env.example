# OpenAI API key. Required unless USE_STUB_PROVIDER=true.
PROVIDER_API_KEY=

# Provider endpoint base. Leave unset to use OpenAI's default.
PROVIDER_BASE_URL=https://api.openai.com/v1

# Model identifier. No stale default is provided on purpose — check
# https://platform.openai.com/docs/models for the current list and set one
# that supports response_format: json_object, e.g. gpt-4o-mini.
MODEL_NAME=

# Turns catalog (iTunes) lookups on/off.
ENABLE_ENRICHMENT=true

# Use the offline stub provider instead of calling OpenAI. Useful for local
# development and demos without a network connection or API key.
USE_STUB_PROVIDER=false

# Comma-separated origins allowed to call this API, e.g.
# http://localhost:5173,https://your-app.netlify.app
ALLOWED_ORIGINS=http://localhost:5173

# Seconds to wait on the provider before giving up.
REQUEST_TIMEOUT=20
